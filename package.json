{
  "name": "n8n-nodes-klicktipp",
  "version": "1.0.48",
  "description": "KlickTipp API integration node for n8n",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "klicktipp",
    "integration",
    "api"
  ],
  "license": "MIT",
  "homepage": "https://github.com/klicktipp/n8n-community-node-klicktipp",
  "author": {
    "name": "KlickTipp Team",
    "email": "github@team.klicktipp.com",
    "url": "https://www.klicktipp.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/klicktipp/n8n-community-node-klicktipp"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "pnpm build && node --test test/*.test.js",
    "prepublishOnly": "pnpm build && pnpm lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KlickTippApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/KlickTipp/Klicktipp.node.js",
      "dist/nodes/KlickTipp/KlicktippTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.55.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "gulp": "^4.0.2",
    "lodash": "^4.18.1",
    "n8n-workflow": "^2.47.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
